{
  "serverInfo": {
    "name": "unportable-schemas-showcase",
    "version": "1.0.0"
  },
  "tools": [
    { "preset": "get_temp" },
    { "preset": "echo" },
    { "preset": "add" },
    { "preset": "get_weather" }
  ],
  "rawToolSchemas": {
    "get_temp": {
      "outputSchema": {
        "type": "object",
        "properties": {
          "data": true,
          "city": { "type": "string" }
        }
      }
    },
    "echo": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "message": { "type": "string" },
          "show_ids": { "type": ["null", "boolean"] },
          "opts": {}
        },
        "required": ["message"]
      }
    },
    "add": {
      "inputSchema": {
        "type": "object",
        "properties": {
          "a": {
            "type": "number",
            "$ref": "https://example.com/schemas/number.json"
          },
          "b": { "type": "number" }
        },
        "required": ["a", "b"]
      }
    }
  },
  "transport": {
    "type": "streamable-http",
    "port": 6603
  }
}
