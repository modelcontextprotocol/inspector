{
  "name": "@modelcontextprotocol/inspector-web",
  "private": true,
  "type": "module",
  "main": "build/index.js",
  "bin": {
    "mcp-inspector-web": "./build/index.js"
  },
  "exports": {
    ".": "./build/index.js"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && npm run build:runner",
    "build:client": "vite build",
    "build:runner": "tsup --config tsup.runner.config.ts",
    "build:storybook": "storybook build",
    "validate": "npm run format:check && npm run lint && npm run build && npm run test",
    "pretest": "npm run test-servers:build",
    "test": "vitest run --project=unit",
    "test:watch": "vitest --project=unit",
    "test:coverage": "npm run test-servers:build && vitest run --project=unit --project=integration --coverage",
    "test:storybook": "vitest run --project=storybook",
    "test:storybook:watch": "vitest --project=storybook",
    "test:integration": "npm run test-servers:build && vitest run --project=integration",
    "test:integration:watch": "npm run test-servers:build && vitest --project=integration",
    "test-servers:build": "tsc -p ../../test-servers --noCheck",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write src server .storybook \"*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
    "format:check": "prettier --check src server .storybook \"*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}\"",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@emotion/react": "^11.14.0",
    "@mantine/core": "^9.5.2",
    "@mantine/form": "^9.5.2",
    "@mantine/hooks": "^9.5.2",
    "@mantine/notifications": "^9.5.2",
    "ace-builds": "^1.44.0",
    "papaparse": "^5.7.0",
    "react-ace": "^15.0.0",
    "react-dom": "^19.2.4",
    "react-icons": "^5.6.0",
    "react-markdown": "^10.1.0",
    "react-syntax-highlighter": "^16.1.1",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-onboarding": "^10.5.10",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.6",
    "@types/express": "^5.0.6",
    "@types/papaparse": "^5.5.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.5",
    "@types/react-syntax-highlighter": "^15.5.13",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/browser-playwright": "4.1.11",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.5",
    "eslint-plugin-storybook": "^10.5.10",
    "happy-dom": "^20.12.0",
    "playwright": "^1.58.2",
    "storybook": "^10.5.5",
    "tsup": "^8.5.1",
    "vite": "^8.2.2",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "esbuild": "^0.28.2"
  }
}
