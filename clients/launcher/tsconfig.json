{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "outDir": "./build",
    "rootDir": "./src",
    "strict": true,
    "skipLibCheck": true
  },
  "include": ["src/**/*"],
  // Exclude tests so `build` (an emitting `tsc`) never compiles a co-located
  // `src/**/*.test.ts` into `build/` — which ships in the published tarball. It
  // also means such a test lands in no tsconfig project, so verify:typecheck-
  // coverage catches it, matching cli/tui. (Tests live in `__tests__/`, checked
  // via tsconfig.test.json.)
  "exclude": ["node_modules", "build", "**/*.test.ts", "**/*.test.tsx"]
}
